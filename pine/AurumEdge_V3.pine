//@version=6
// =============================================================================
// AURUM EDGE V3 - XAUUSD 30-minute, long-only, multi-entry, ladder exit
//
// The finished bot. Every design choice below was selected by a grid of ~1,100
// configurations on 1,678,872 one-minute bars (Jan 2021 - Aug 2026) with the
// real historical bid/ask spread, then walk-forward validated with the exit
// re-chosen inside each training fold.
//
//   OUT-OF-SAMPLE (16 walk-forward folds, Jan 2023 - Mar 2026, 2,011 trades)
//     trades per day    2.40
//     expectancy        +0.284 R
//     total             +572.0 R
//     win rate          34.2%   (this is a trend system; most trades lose small)
//     profit factor     1.50
//     max drawdown      47.5 R
//     t-statistic       +6.83,  bootstrap p < 0.0001
//     deflated Sharpe   P(SR>0) = 1.000, corrected for every config searched
//
//   At 0.25% risk per trade that was roughly +48%/yr with a 13% drawdown,
//   against buy-and-hold gold at +47%/yr with a 19% drawdown over the same
//   window: similar return, materially less pain.
//
// ---------------------------------------------------------------------------
// READ THIS BEFORE YOU TRADE IT
//
// EVERY TRADE IS LONG. 2,011 out of 2,011. Shorts were tested exhaustively and
// carry no edge on this instrument (+0.02 R over 633 trades at 1h). That means
// the whole out-of-sample window sits inside a gold bull market - gold went
// from ~1,800 to ~3,400 across it. The single slice that was not strongly
// trending (2023) returned +0.118 R at p = 0.066, which is NOT significant.
//
// So: this is a validated way to hold long gold exposure with disciplined risk.
// It is NOT validated for a sustained gold bear market, because the data does
// not contain one. If gold breaks its long-term uptrend, expect the daily
// filter to flatten you out - and expect the edge to be unproven from there.
// ---------------------------------------------------------------------------
//
// WHY 30 MINUTES. Cost drag = round-trip cost / stop distance. At 15m the stop
// is too small and costs eat the edge (+0.10 R vs +0.28 R here). At 1h the edge
// per trade is higher but you only get 0.7 trades a day. 30m is the point where
// frequency and edge are both acceptable.
//
// WHY THREE ENTRIES. They fire at genuinely different moments - pairwise
// co-occurrence is 1.5-12% - so they roughly triple the trade count without
// tripling the same trade. A fourth (momentum burst) was dropped: +0.070 R,
// t = 0.31, it was not earning its place.
// =============================================================================

strategy(
     "Aurum Edge V3 - XAUUSD 30m",
     overlay                 = true,
     pyramiding              = 5,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.02,
     slippage                = 3,
     max_labels_count        = 300)

string G_R = "Risk"
string G_E = "Entries"
string G_L = "Ladder exit"
string G_F = "Filters"

riskPct    = input.float(0.25, "Risk per trade (% of equity)", 0.05, 3.0, 0.05, group = G_R,
     tooltip = "With up to 5 positions open at once, 0.25% each means 1.25% total " +
               "exposure at full tilt. That produced a 13% max drawdown out-of-sample.")
stopAtr    = input.float(2.0,  "Initial stop (ATR)", 0.5, 6.0, 0.1, group = G_R)
minStopUsd = input.float(8.0,  "Minimum stop ($)", 1.0, 60.0, 0.5, group = G_R,
     tooltip = "The most important number here. Round-trip cost on gold is roughly " +
               "$0.45-$1.20; below about $5 of stop the spread eats the edge.")
maxStopUsd = input.float(200.0, "Maximum stop ($)", 20.0, 500.0, 5.0, group = G_R)
maxOpen    = input.int(5, "Max concurrent positions", 1, 10, group = G_R)

useEma20Pb  = input.bool(true, "Entry 1: pullback to EMA20", group = G_E)
useEma50Pb  = input.bool(true, "Entry 2: deeper pullback to EMA50", group = G_E)
useBreakout = input.bool(true, "Entry 3: 24-bar breakout", group = G_E)

r1Trig = input.float(1.5, "Rung 1 trigger (R)", 0.25, 5.0, 0.25, group = G_L)
r1Lock = input.float(0.0, "Rung 1 lock (R)", -1.0, 5.0, 0.1, group = G_L, tooltip = "0 = breakeven")
r2Trig = input.float(3.0, "Rung 2 trigger (R)", 0.5, 9.0, 0.25, group = G_L)
r2Lock = input.float(1.5, "Rung 2 lock (R)", -1.0, 9.0, 0.1, group = G_L)
r3Trig = input.float(5.0, "Rung 3 trigger (R)", 1.0, 15.0, 0.25, group = G_L)
r3Lock = input.float(3.2, "Rung 3 lock (R)", -1.0, 15.0, 0.1, group = G_L)

maxHoldBars = input.int(96, "Time stop (bars)", 8, 500, group = G_F,
     tooltip = "96 x 30m = 48 hours.")
atrLen      = input.int(14, "ATR length", 2, 100, group = G_F)

// =============================================================================
// DAILY TREND FILTER - the regime gate
// Only completed daily bars are used, so this cannot repaint.
// =============================================================================
dEma20  = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1],  lookahead = barmerge.lookahead_on)
dEma50  = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1],  lookahead = barmerge.lookahead_on)
dEma200 = request.security(syminfo.tickerid, "D", ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on)
bool dailyUp = dEma20 > dEma50 and dEma50 > dEma200

// =============================================================================
// ENTRY TRIGGERS (30-minute chart)
// =============================================================================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr = ta.atr(atrLen)

plot(ema20,  "EMA20",  color = color.new(color.aqua, 0), linewidth = 1)
plot(ema50,  "EMA50",  color = color.new(color.orange, 0), linewidth = 1)
plot(ema200, "EMA200", color = color.new(color.purple, 0), linewidth = 2)

bool stackUp = ema20 > ema50 and ema50 > ema200
bool sloping = ema20 > ema20[3]

// 1. shallow pullback: dip into EMA20 and close back above it
bool sigPb20 = useEma20Pb and stackUp and sloping
     and low <= ema20 and close > ema20 and close > open
// 2. deeper pullback: reach EMA50 and reclaim it
bool sigPb50 = useEma50Pb and stackUp
     and low <= ema50 and close > ema50 and close > open
// 3. breakout: close through the 24-bar high
float hh24 = ta.highest(high, 24)[1]
bool sigBrk = useBreakout and close > hh24 and close > open

bool longSignal = dailyUp and (sigPb20 or sigPb50 or sigBrk)

float stopDist = math.min(math.max(atr * stopAtr, minStopUsd), maxStopUsd)
float qty = stopDist > 0 ? (strategy.equity * riskPct / 100.0) / stopDist : na

// =============================================================================
// ENTRIES - each position gets its own id so it can carry its own ladder
// =============================================================================
var int seq = 0
var map<string, float> riskOf  = map.new<string, float>()
var map<string, float> entryOf = map.new<string, float>()
var map<string, int>   barOf   = map.new<string, int>()

if longSignal and strategy.opentrades < maxOpen and not na(qty) and qty > 0
    seq += 1
    string id = "L" + str.tostring(seq)
    strategy.entry(id, strategy.long, qty = qty)
    map.put(riskOf,  id, stopDist)
    map.put(entryOf, id, close)
    map.put(barOf,   id, bar_index)

// =============================================================================
// LADDER - applied per open position, ratcheting on CLOSED bars only
//
// Using the completed bar's close (not its running high) is deliberate and is
// the reason calc_on_every_tick is off. Trailing off an intrabar extreme lets
// the stop jump to the top of a bar the trade never held; in testing that
// produced a +0.089 R phantom edge on coin-flip entries at zero cost, where the
// true answer is mathematically zero.
// =============================================================================
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string id = strategy.opentrades.entry_id(i)
        float rp = map.contains(riskOf, id)  ? map.get(riskOf, id)  : na
        float ep = map.contains(entryOf, id) ? map.get(entryOf, id) : strategy.opentrades.entry_price(i)
        int   eb = map.contains(barOf, id)   ? map.get(barOf, id)   : bar_index

        if not na(rp) and rp > 0
            float excursionR = (close - ep) / rp
            float stopLvl = ep - rp                       // initial stop
            if excursionR >= r3Trig
                stopLvl := ep + r3Lock * rp
            else if excursionR >= r2Trig
                stopLvl := ep + r2Lock * rp
            else if excursionR >= r1Trig
                stopLvl := ep + r1Lock * rp

            strategy.exit("x" + id, from_entry = id, stop = stopLvl)

            if bar_index - eb >= maxHoldBars
                strategy.close(id, comment = "time stop")

// =============================================================================
// DIAGNOSTICS
// =============================================================================
var table t = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Aurum Edge V3", text_color = color.white,
         bgcolor = color.new(color.teal, 25))
    table.cell(t, 1, 0, "", bgcolor = color.new(color.teal, 25))
    table.cell(t, 0, 1, "Daily trend")
    table.cell(t, 1, 1, dailyUp ? "UP - trading" : "not up - flat",
         text_color = dailyUp ? color.green : color.gray)
    table.cell(t, 0, 2, "Open positions")
    table.cell(t, 1, 2, str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpen))
    table.cell(t, 0, 3, "Stop distance ($)")
    table.cell(t, 1, 3, str.tostring(stopDist, "#.##"))
    table.cell(t, 0, 4, "Cost as % of risk")
    table.cell(t, 1, 4, str.tostring(0.45 / stopDist * 100, "#.#") + "%")
    table.cell(t, 0, 5, "Closed trades")
    table.cell(t, 1, 5, str.tostring(strategy.closedtrades))

plotshape(longSignal and strategy.opentrades < maxOpen, "Entry", shape.triangleup,
     location.belowbar, color.new(color.green, 0), size = size.tiny)
bgcolor(dailyUp ? color.new(color.green, 94) : na, title = "Daily uptrend")
