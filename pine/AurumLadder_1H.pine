//@version=6
// =============================================================================
// Aurum Ladder - XAUUSD 1-hour, long-only, step-trailing exit
//
// The only configuration in this study that survived walk-forward validation
// with its deflated Sharpe intact.
//
//   Out-of-sample (17 walk-forward folds, Apr 2022 - Jul 2026, 820 trades)
//     expectancy      +0.396 R per trade
//     total           +324.6 R
//     win rate        37.1%   (avg win 2.52 R, avg loss -0.86 R)
//     profit factor   1.74
//     max drawdown    30.9 R
//     t-statistic     +6.01,  bootstrap p < 0.0001
//     deflated Sharpe P(SR>0) = 0.995, corrected for 170 configurations searched
//
// WHY IT IS LONG ONLY
//   Shorts returned +0.024 R across 633 trades - no edge - and including them
//   pushes the deflated Sharpe to zero. Gold rose 113% across the test window,
//   so a large part of this is leveraged exposure to a bull market. In gold's
//   FLAT stretch (2022-2023) the edge was +0.167 R at p = 0.041: real, but
//   marginal. A sustained gold bear market is outside the evidence base.
//
// THE DETAIL THAT MATTERS MOST
//   The ladder ratchets on CLOSED BARS, never on a bar's running high. Trailing
//   off the intrabar extreme lets the stop jump to the top of a bar the trade
//   never actually held; in testing that artefact produced +0.089 R per trade on
//   coin-flip entries with costs switched off, where the true answer is zero.
//   `calc_on_every_tick = false` below is load-bearing, not a preference.
// =============================================================================

strategy(
     "Aurum Ladder - XAUUSD 1H",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.02,
     slippage                = 3,
     max_labels_count        = 300)

string G_R = "Risk"
string G_L = "Ladder"
string G_S = "Signal"

riskPct    = input.float(0.5, "Risk per trade (% of equity)", 0.05, 5.0, 0.05, group = G_R,
     tooltip = "0.5% gave +38.3%/yr with a 15.5% max drawdown out-of-sample, versus " +
               "+26.6%/yr and 27.3% for buy-and-hold over the same window.")
stopAtr    = input.float(2.0, "Initial stop (ATR)", 0.5, 6.0, 0.1, group = G_R)
minStopUsd = input.float(10.0, "Minimum stop ($)", 1.0, 60.0, 1.0, group = G_R,
     tooltip = "Cost drag is round-trip cost divided by stop distance. Below about " +
               "$5 on gold the spread eats the edge whatever the signal is.")
maxStopUsd = input.float(200.0, "Maximum stop ($)", 20.0, 500.0, 5.0, group = G_R)

// Rungs. Selected inside walk-forward training windows; this geometry was chosen
// in 7 of 17 folds and also wins independently at 4-hour and daily.
r1Trig = input.float(1.5, "Rung 1 trigger (R)", 0.25, 5.0, 0.25, group = G_L)
r1Lock = input.float(0.0, "Rung 1 lock (R)",   -1.0, 5.0, 0.1,  group = G_L,
     tooltip = "0.0 = breakeven.")
r2Trig = input.float(3.0, "Rung 2 trigger (R)", 0.5,  9.0, 0.25, group = G_L)
r2Lock = input.float(1.5, "Rung 2 lock (R)",   -1.0, 9.0, 0.1,  group = G_L)
r3Trig = input.float(5.0, "Rung 3 trigger (R)", 1.0, 15.0, 0.25, group = G_L)
r3Lock = input.float(3.2, "Rung 3 lock (R)",   -1.0, 15.0, 0.1, group = G_L)

emaFast  = input.int(20,  "Fast EMA", 2, 100, group = G_S)
emaSlow  = input.int(50,  "Slow EMA", 3, 200, group = G_S)
emaTrend = input.int(200, "Trend EMA", 20, 500, group = G_S)
atrLen   = input.int(14,  "ATR length", 2, 100, group = G_S)
maxHoldBars = input.int(72, "Time stop (bars)", 4, 500, group = G_S)

// =============================================================================
// SIGNAL
// =============================================================================
ema20  = ta.ema(close, emaFast)
ema50  = ta.ema(close, emaSlow)
ema200 = ta.ema(close, emaTrend)
atr    = ta.atr(atrLen)

plot(ema20,  "EMA20",  color = color.new(color.aqua, 0),   linewidth = 2)
plot(ema50,  "EMA50",  color = color.new(color.orange, 0), linewidth = 1)
plot(ema200, "EMA200", color = color.new(color.purple, 0), linewidth = 2)

bool stacked  = ema20 > ema50 and ema50 > ema200
bool rising   = ema20 > ema20[3]
bool pullback = low <= ema20 and close > ema20 and close > open
bool longSig  = stacked and rising and pullback          // long only, by design

float stopDist = math.min(math.max(atr * stopAtr, minStopUsd), maxStopUsd)
float qty      = stopDist > 0 ? (strategy.equity * riskPct / 100.0) / stopDist : na

// =============================================================================
// LADDER STATE
// =============================================================================
var float entryPx  = na
var float riskPx   = na
var float stopNow  = na
var int   barsHeld = 0

bool flat = strategy.position_size == 0
if flat
    entryPx  := na
    riskPx   := na
    stopNow  := na
    barsHeld := 0
else
    barsHeld += 1

if longSig and flat and not na(qty) and qty > 0
    strategy.entry("L", strategy.long, qty = qty)
    entryPx := close
    riskPx  := stopDist
    stopNow := close - stopDist

// Ratchet on the CLOSED bar. `close` here is the completed bar's close, and the
// updated stop applies from the next bar - which is exactly why this is safe.
if strategy.position_size > 0 and not na(riskPx) and riskPx > 0
    float excursionR = (close - entryPx) / riskPx
    if excursionR >= r3Trig
        stopNow := math.max(stopNow, entryPx + r3Lock * riskPx)
    else if excursionR >= r2Trig
        stopNow := math.max(stopNow, entryPx + r2Lock * riskPx)
    else if excursionR >= r1Trig
        stopNow := math.max(stopNow, entryPx + r1Lock * riskPx)

    strategy.exit("L-x", from_entry = "L", stop = stopNow)   // no profit target

    if barsHeld >= maxHoldBars
        strategy.close("L", comment = "time stop")

plot(strategy.position_size > 0 ? stopNow : na, "Ladder stop",
     color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
plotshape(longSig and flat, "Entry", shape.triangleup, location.belowbar,
     color.new(color.green, 0), size = size.tiny)

// =============================================================================
// DIAGNOSTICS
// =============================================================================
var table t = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Aurum Ladder 1H", text_color = color.white,
         bgcolor = color.new(color.teal, 25))
    table.cell(t, 1, 0, "", bgcolor = color.new(color.teal, 25))
    table.cell(t, 0, 1, "Stop distance ($)")
    table.cell(t, 1, 1, str.tostring(stopDist, "#.##"))
    table.cell(t, 0, 2, "Cost as % of risk")
    table.cell(t, 1, 2, str.tostring(0.45 / stopDist * 100, "#.#") + "%")
    table.cell(t, 0, 3, "Position")
    table.cell(t, 1, 3, strategy.position_size > 0 ? "LONG" : "flat")
    table.cell(t, 0, 4, "Open R")
    table.cell(t, 1, 4, strategy.position_size > 0 and not na(riskPx)
         ? str.tostring((close - entryPx) / riskPx, "#.##") + " R" : "-")
    table.cell(t, 0, 5, "Rungs armed")
    float exc = strategy.position_size > 0 and not na(riskPx) ? (close - entryPx) / riskPx : 0.0
    table.cell(t, 1, 5, exc >= r3Trig ? "3 / 3" : exc >= r2Trig ? "2 / 3"
         : exc >= r1Trig ? "1 / 3" : "0 / 3")
