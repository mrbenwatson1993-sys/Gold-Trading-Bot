//@version=5
// =============================================================================
// AURUM EDGE V6 - LIVE / FORWARD-TEST EDITION - XAUUSD 30m
//
// Same validated engine as V5, instrumented for forward testing:
//   - every trade draws its ENTRY / STOP / TARGET on the chart and leaves them
//     there, so you can scroll back and judge accuracy by eye;
//   - the three ladder rungs are drawn as dotted levels, so you can see where
//     the stop is going to move before it moves;
//   - alerts carry the exact numbers you need to place the order by hand, plus
//     separate alerts when a rung arms (move your stop) and when a trade exits;
//   - a live panel shows open trades, current R, and distance to stop/target;
//   - a running scoreboard tracks hit rate so live results can be compared
//     against the backtest as they accumulate.
//
// VALIDATED PERFORMANCE (walk-forward, 16 folds, out-of-sample only)
//   2.75 trades/day   n=2307   E[R] +0.290 R   total +668.2 R
//   win 35.5%   PF 1.50   maxDD 43.0 R   t=+7.52   p<0.0001
//   deflated Sharpe P(SR>0) = 1.000
//
//   Watch the win rate. 35% is CORRECT for this system - it is a trend
//   follower, so most trades are small losses and a few large winners carry it.
//   Average win is roughly 2.9x the average loss. If you see 35% wins and
//   conclude it is broken, you will switch it off exactly when it is working.
//
// THE CAVEAT, UNCHANGED
//   Every trade is long, and the whole test window is a gold bull market. In
//   gold's least-trending slice it returned +0.118 R at p=0.066, which is not
//   significant. This is a validated way to hold long gold with disciplined
//   risk; it is not validated for a sustained bear market.
//
// FORWARD-TEST SETUP
//   1. XAUUSD, 30-minute chart.
//   2. Set commission_value below to YOUR broker's real per-ounce cost.
//   3. Alerts: create an alert on this strategy, condition "Any alert() function
//      call", set to "Once per bar close". That is what makes the messages fire
//      with final numbers rather than mid-bar guesses.
//   4. Log every alert with its timestamp, then log when you actually got filled.
//      The gap between the two is your real execution cost, and it is the whole
//      point of this exercise.
// =============================================================================

strategy(
     "Aurum Edge V6 LIVE - XAUUSD 30m",
     overlay                 = true,
     pyramiding              = 10,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.02,
     slippage                = 3,
     max_labels_count        = 500,
     max_lines_count         = 500,
     max_boxes_count         = 500)

// =============================================================================
// INPUTS
// =============================================================================
string G_ENG = "1. Engines"
string G_R   = "2. Risk"
string G_LE  = "3. Long entries"
string G_LAD = "4. Ladder exit"
string G_VIS = "5. Chart display"
string G_ALR = "6. Alerts"
string G_PROP = "7. Prop-firm session rules"

enableLong  = input.bool(true,  "Enable Long Engine (bull regime)", group = G_ENG)
enableShort = input.bool(false, "Enable Symmetric Short Engine (bear regime)", group = G_ENG,
     tooltip = "OFF by default: measured at -0.086 R over 491 trades in a genuine bear " +
               "sample (18.6% of history). 26 short variants were tested; all lost.")

riskPct    = input.float(0.25, "Risk per trade (% of equity)", 0.05, 3.0, 0.05, group = G_R)
stopAtr    = input.float(2.0,  "Initial stop (ATR)", 0.5, 6.0, 0.1, group = G_R)
minStopUsd = input.float(8.0,  "Minimum stop ($)", 1.0, 60.0, 0.5, group = G_R)
maxStopUsd = input.float(200.0, "Maximum stop ($)", 20.0, 500.0, 5.0, group = G_R)
maxOpen    = input.int(5, "Max concurrent positions", 1, 10, group = G_R)
acctSize   = input.float(10000, "Account size for alert sizing ($)", 100, 10000000, 100, group = G_R,
     tooltip = "Used only to print a suggested lot size in the alert text.")

useDip   = input.bool(true, "E1: unconfirmed dip (N red bars in uptrend)", group = G_LE)
dipBars  = input.int(2, "   red bars required", 1, 5, group = G_LE)
useBrk   = input.bool(true, "E2: 24-bar breakout", group = G_LE)
useLegacy = input.bool(false, "E3: V3 confirmed pullback (optional)", group = G_LE,
     tooltip = "Adds ~0.06 trades/day at +0.297 R but raises drawdown 43.0 -> 48.3 R.")

r1Trig = input.float(1.5, "Rung 1 trigger (R)", 0.25, 5.0, 0.25, group = G_LAD)
r1Lock = input.float(0.0, "Rung 1 lock (R)", -1.0, 5.0, 0.1, group = G_LAD)
r2Trig = input.float(3.0, "Rung 2 trigger (R)", 0.5, 9.0, 0.25, group = G_LAD)
r2Lock = input.float(1.5, "Rung 2 lock (R)", -1.0, 9.0, 0.1, group = G_LAD)
r3Trig = input.float(5.0, "Rung 3 trigger (R)", 1.0, 15.0, 0.25, group = G_LAD)
r3Lock = input.float(3.2, "Rung 3 lock (R)", -1.0, 15.0, 0.1, group = G_LAD)
refTpR = input.float(3.0, "Reference target for alerts (R)", 1.0, 10.0, 0.25, group = G_LAD,
     tooltip = "The ladder has no fixed target - it rides the trend. But a manual trader " +
               "needs a number to type in, so this is the target quoted in alerts and " +
               "drawn on the chart. The walk-forward picked a 3R target in 10 of 16 folds.")
useHardTp   = input.bool(false, "Actually exit at the reference target", group = G_LAD,
     tooltip = "OFF = ladder runs free (validated). ON = hard 3R exit, simpler to trade " +
               "manually but gives up the long tail.")
maxHoldBars = input.int(96, "Time stop (bars)", 8, 500, group = G_LAD)
atrLen      = input.int(14, "ATR length", 2, 100, group = G_LAD)

showLines  = input.bool(true, "Draw entry / stop / target lines", group = G_VIS)
showRungs  = input.bool(true, "Draw ladder rung levels", group = G_VIS)
showLabels = input.bool(true, "Label entries with prices", group = G_VIS)
showPanel  = input.bool(true, "Show live panel", group = G_VIS)
showScore  = input.bool(true, "Show running scoreboard", group = G_VIS)
tintBg     = input.bool(true, "Tint background by regime", group = G_VIS)
keepClosed = input.bool(true, "Keep closed trades drawn on the chart", group = G_VIS)

alertEntry = input.bool(true, "Alert on entry", group = G_ALR)
alertRung  = input.bool(true, "Alert when a rung arms (move your stop)", group = G_ALR)
alertExit  = input.bool(true, "Alert on exit", group = G_ALR)

// Measured cost of each rule, out-of-sample 2023-01 -> 2026-03, 2,203 trades,
// after real spreads AND overnight financing:
//
//   as shipped (48h hold)      +0.248 R/trade,  +545 R total
//   flat before Friday close   +0.245 R/trade,  +544 R total   <- essentially free
//   24h hold + flat Friday     +0.204 R/trade,  +543 R total   <- also free in total
//   no overnight at all        +0.143 R/trade,  +428 R total   <- costs 21% of profit
//
// Shortening the hold lowers expectancy per trade but raises the trade count by
// about the same proportion, so the first two rules cost almost nothing. Banning
// overnight holds entirely is the one that actually hurts.
flatFriday = input.bool(false, "Flatten everything before the weekend", group = G_PROP,
     tooltip = "Removes weekend gap risk for -0.4% of total profit. 5.6% of weekends " +
               "gapped more than 1x the stop distance; the worst was 4x. With five " +
               "correlated longs open that is the one event that can end a prop account " +
               "in a single print.")
friFlatH   = input.int(20, "   Friday flatten hour (UTC)", 12, 23, group = G_PROP)
flatDaily  = input.bool(false, "Flatten before the daily rollover (no overnight)", group = G_PROP,
     tooltip = "True intraday operation. Costs 21% of total profit and removes financing " +
               "cost. Turn on only if your firm forbids overnight positions.")
dayFlatH   = input.int(20, "   Daily flatten hour (UTC)", 0, 23, group = G_PROP)

// =============================================================================
// REGIME + SIGNALS
// =============================================================================
dE20  = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1],  lookahead = barmerge.lookahead_on)
dE50  = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1],  lookahead = barmerge.lookahead_on)
dE200 = request.security(syminfo.tickerid, "D", ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on)
bool macroBull = dE20 > dE50 and dE50 > dE200
bool macroBear = dE20 < dE50 and dE50 < dE200

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr    = ta.atr(atrLen)

plot(ema20,  "EMA20",  color = color.new(color.aqua, 30),   linewidth = 1)
plot(ema50,  "EMA50",  color = color.new(color.orange, 30), linewidth = 1)
plot(ema200, "EMA200", color = color.new(color.purple, 20), linewidth = 2)

bool stackUp = ema20 > ema50 and ema50 > ema200
bool stackDn = ema20 < ema50 and ema50 < ema200
float hh24 = ta.highest(high, 24)[1]
float ll24 = ta.lowest(low, 24)[1]

int redRun = 0
int grnRun = 0
for i = 0 to dipBars - 1
    redRun += close[i] < open[i] ? 1 : 0
    grnRun += close[i] > open[i] ? 1 : 0

bool sigDip    = useDip    and stackUp and redRun == dipBars
bool sigBrk    = useBrk    and close > hh24 and close > open
bool sigLegacy = useLegacy and stackUp and ema20 > ema20[3] and low <= ema20 and close > ema20 and close > open
bool longSignal = enableLong and macroBull and (sigDip or sigBrk or sigLegacy)

bool sigDipS = useDip and stackDn and grnRun == dipBars
bool sigBrkS = useBrk and close < ll24 and close < open
bool shortSignal = enableShort and macroBear and (sigDipS or sigBrkS)

float stopDist = math.min(math.max(atr * stopAtr, minStopUsd), maxStopUsd)
float qty = stopDist > 0 ? (strategy.equity * riskPct / 100.0) / stopDist : na
float suggestedOz = stopDist > 0 ? (acctSize * riskPct / 100.0) / stopDist : na

int openLongs = 0
int openShorts = 0
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        if strategy.opentrades.size(i) > 0
            openLongs += 1
        else
            openShorts += 1

// =============================================================================
// TRADE STATE + CHART DRAWING
// Parallel arrays keep each open trade's own levels and its own drawings, so a
// position opened three bars ago keeps its own stop and its own lines when a
// second one opens beside it.
// =============================================================================
var array<string> tIds   = array.new_string()
var array<float>  tEntry = array.new_float()
var array<float>  tRisk  = array.new_float()
var array<int>    tDir   = array.new_int()
var array<int>    tBar   = array.new_int()
var array<int>    tRung  = array.new_int()     // rungs armed so far
var array<line>   lnE    = array.new_line()
var array<line>   lnS    = array.new_line()
var array<line>   lnT    = array.new_line()
var array<line>   lnR1   = array.new_line()
var array<line>   lnR2   = array.new_line()
var array<line>   lnR3   = array.new_line()

var int seq = 0
var int wins = 0
var int losses = 0
var float sumR = 0.0

_mkline(float y, color col, string st, int w, bool on) =>
    line out = na
    if on
        out := line.new(bar_index, y, bar_index, y, xloc = xloc.bar_index,
             color = col, style = st, width = w)
    out

_open(int dir, string tag) =>
    seq += 1
    string id = (dir > 0 ? "L" : "S") + str.tostring(seq)
    float ep = close
    float sl = ep - stopDist * dir
    float tp = ep + stopDist * refTpR * dir
    if dir > 0
        strategy.entry(id, strategy.long, qty = qty)
    else
        strategy.entry(id, strategy.short, qty = qty)

    array.push(tIds, id)
    array.push(tEntry, ep)
    array.push(tRisk, stopDist)
    array.push(tDir, dir)
    array.push(tBar, bar_index)
    array.push(tRung, 0)
    bool drawRungs = showLines and showRungs
    array.push(lnE,  _mkline(ep, color.new(color.yellow, 0), line.style_solid, 2, showLines))
    array.push(lnS,  _mkline(sl, color.new(color.red, 0),    line.style_solid, 2, showLines))
    array.push(lnT,  _mkline(tp, color.new(color.green, 0),  line.style_solid, 2, showLines))
    array.push(lnR1, _mkline(ep + r1Trig * stopDist * dir, color.new(color.gray, 40), line.style_dotted, 1, drawRungs))
    array.push(lnR2, _mkline(ep + r2Trig * stopDist * dir, color.new(color.gray, 55), line.style_dotted, 1, drawRungs))
    array.push(lnR3, _mkline(ep + r3Trig * stopDist * dir, color.new(color.gray, 70), line.style_dotted, 1, drawRungs))

    if showLabels
        label.new(bar_index, dir > 0 ? low : high,
             (dir > 0 ? "▲ " : "▼ ") + tag + "\n" + str.tostring(ep, format.mintick),
             style = dir > 0 ? label.style_label_up : label.style_label_down,
             color = dir > 0 ? color.new(color.green, 15) : color.new(color.red, 15),
             textcolor = color.white, size = size.tiny)

    if alertEntry
        alert(
             (dir > 0 ? "🟢 LONG " : "🔴 SHORT ") + syminfo.ticker + "  [" + tag + "]" +
             "\nENTRY  " + str.tostring(ep, format.mintick) +
             "\nSTOP   " + str.tostring(sl, format.mintick) +
             "  (" + str.tostring(stopDist, "#.##") + " away)" +
             "\nTARGET " + str.tostring(tp, format.mintick) +
             "  (" + str.tostring(refTpR, "#.#") + "R)" +
             "\nSIZE   " + str.tostring(suggestedOz, "#.###") + " oz  @ " +
             str.tostring(riskPct, "#.##") + "% of " + str.tostring(acctSize, "#") +
             "\nRISK   $" + str.tostring(suggestedOz * stopDist, "#.##") +
             "\nBAR    " + str.format_time(time_close, "yyyy-MM-dd HH:mm", "UTC") + " UTC",
             alert.freq_once_per_bar_close)
    id

// -----------------------------------------------------------------------------
// SESSION GUARD. Both rules are evaluated in UTC on the completed bar, so they
// fire at the same moment in backtest and in live trading regardless of the
// chart's timezone.
// -----------------------------------------------------------------------------
bool weekendCut = flatFriday and dayofweek(time, "UTC") == dayofweek.friday
     and hour(time, "UTC") >= friFlatH
bool rolloverCut = flatDaily and hour(time, "UTC") >= dayFlatH
bool forceFlat = weekendCut or rolloverCut

if forceFlat and strategy.opentrades > 0
    strategy.close_all(comment = weekendCut ? "weekend flat" : "session flat")

if longSignal and not forceFlat and openLongs < maxOpen and not na(qty) and qty > 0
    _open(1, sigDip ? "DIP" : sigBrk ? "BREAKOUT" : "PULLBACK")

if shortSignal and not forceFlat and openShorts < maxOpen and not na(qty) and qty > 0
    _open(-1, sigDipS ? "RALLY" : "BREAKDOWN")

// =============================================================================
// MANAGE OPEN TRADES: ladder, drawings, exits
// The ratchet reads the COMPLETED bar's close, never an intrabar extreme. That
// is why calc_on_every_tick is false - trailing from a running high banks levels
// the trade never actually held.
// =============================================================================
int nTrades = array.size(tIds)
if nTrades > 0
    for k = nTrades - 1 to 0
        string id = array.get(tIds, k)
        float ep  = array.get(tEntry, k)
        float rp  = array.get(tRisk, k)
        int   dir = array.get(tDir, k)
        int   eb  = array.get(tBar, k)
        int   rung = array.get(tRung, k)

        bool stillOpen = false
        if strategy.opentrades > 0
            for i = 0 to strategy.opentrades - 1
                if strategy.opentrades.entry_id(i) == id
                    stillOpen := true

        if stillOpen and rp > 0
            float excR = (close - ep) * dir / rp
            float sl = ep - rp * dir
            int newRung = 0
            if excR >= r3Trig
                sl := ep + r3Lock * rp * dir
                newRung := 3
            else if excR >= r2Trig
                sl := ep + r2Lock * rp * dir
                newRung := 2
            else if excR >= r1Trig
                sl := ep + r1Lock * rp * dir
                newRung := 1

            if newRung > rung
                array.set(tRung, k, newRung)
                if alertRung
                    alert("🔧 MOVE STOP  " + syminfo.ticker + "  [" + id + "]" +
                         "\nReached +" + str.tostring(newRung == 3 ? r3Trig : newRung == 2 ? r2Trig : r1Trig, "#.#") + "R" +
                         "\nNEW STOP  " + str.tostring(sl, format.mintick) +
                         (math.abs(sl - ep) < syminfo.mintick ? "  (breakeven)" :
                          "  (locks +" + str.tostring((sl - ep) * dir / rp, "#.##") + "R)") +
                         "\nEntry was " + str.tostring(ep, format.mintick),
                         alert.freq_once_per_bar_close)

            float tp = ep + rp * refTpR * dir
            if useHardTp
                strategy.exit("x" + id, from_entry = id, stop = sl, limit = tp)
            else
                strategy.exit("x" + id, from_entry = id, stop = sl)

            if not na(array.get(lnE, k))
                line.set_x2(array.get(lnE, k), bar_index)
                line.set_xy2(array.get(lnS, k), bar_index, sl)
                line.set_x2(array.get(lnT, k), bar_index)
            if not na(array.get(lnR1, k))
                line.set_x2(array.get(lnR1, k), bar_index)
                line.set_x2(array.get(lnR2, k), bar_index)
                line.set_x2(array.get(lnR3, k), bar_index)

            if bar_index - eb >= maxHoldBars
                strategy.close(id, comment = "time stop")

        else if not stillOpen
            // Trade has closed: score it, alert, and stop extending its drawings.
            float exitPx = close
            float rMult = (exitPx - ep) * dir / rp
            sumR += rMult
            if rMult > 0
                wins += 1
            else
                losses += 1
            if alertExit
                alert((rMult > 0 ? "✅ CLOSED +" : "❌ CLOSED ") + str.tostring(rMult, "#.##") + "R  " +
                     syminfo.ticker + "  [" + id + "]" +
                     "\nEntry " + str.tostring(ep, format.mintick) +
                     "  ->  Exit ~" + str.tostring(exitPx, format.mintick) +
                     "\nHeld " + str.tostring(bar_index - eb) + " bars",
                     alert.freq_once_per_bar_close)
            if not keepClosed
                if not na(array.get(lnE, k))
                    line.delete(array.get(lnE, k))
                    line.delete(array.get(lnS, k))
                    line.delete(array.get(lnT, k))
                if not na(array.get(lnR1, k))
                    line.delete(array.get(lnR1, k))
                    line.delete(array.get(lnR2, k))
                    line.delete(array.get(lnR3, k))
            array.remove(tIds, k)
            array.remove(tEntry, k)
            array.remove(tRisk, k)
            array.remove(tDir, k)
            array.remove(tBar, k)
            array.remove(tRung, k)
            array.remove(lnE, k)
            array.remove(lnS, k)
            array.remove(lnT, k)
            array.remove(lnR1, k)
            array.remove(lnR2, k)
            array.remove(lnR3, k)

// =============================================================================
// DISPLAY
// =============================================================================
bgcolor(tintBg and macroBull ? color.new(color.green, 95) :
        tintBg and macroBear ? color.new(color.red, 95) : na, title = "Regime")

plotshape(longSignal,  "Long signal",  shape.triangleup,   location.belowbar,
     color.new(color.green, 0), size = size.tiny)
plotshape(shortSignal, "Short signal", shape.triangledown, location.abovebar,
     color.new(color.red, 0),   size = size.tiny)

var table pnl = table.new(position.top_right, 2, 9, border_width = 1)
if barstate.islast and showPanel
    table.cell(pnl, 0, 0, "AURUM V6 LIVE", text_color = color.white,
         bgcolor = color.new(color.teal, 20))
    table.cell(pnl, 1, 0, "", bgcolor = color.new(color.teal, 20))
    table.cell(pnl, 0, 1, "Daily regime")
    table.cell(pnl, 1, 1, macroBull ? "BULL — armed" : macroBear ? "BEAR" : "neutral — flat",
         text_color = macroBull ? color.green : macroBear ? color.red : color.gray)
    table.cell(pnl, 0, 2, "Open trades")
    table.cell(pnl, 1, 2, str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpen))
    table.cell(pnl, 0, 3, "Next stop ($)")
    table.cell(pnl, 1, 3, str.tostring(stopDist, "#.##"))
    table.cell(pnl, 0, 4, "Next size (oz)")
    table.cell(pnl, 1, 4, str.tostring(suggestedOz, "#.###"))
    table.cell(pnl, 0, 5, "Next risk ($)")
    table.cell(pnl, 1, 5, "$" + str.tostring(suggestedOz * stopDist, "#.##"))
    table.cell(pnl, 0, 6, "Cost as % of risk")
    table.cell(pnl, 1, 6, str.tostring(0.45 / stopDist * 100, "#.#") + "%")
    table.cell(pnl, 0, 7, "Open R (unrealised)")
    float openR = 0.0
    if array.size(tIds) > 0
        for k = 0 to array.size(tIds) - 1
            openR += (close - array.get(tEntry, k)) * array.get(tDir, k) / array.get(tRisk, k)
    table.cell(pnl, 1, 7, str.tostring(openR, "#.##") + " R",
         text_color = openR >= 0 ? color.green : color.red)
    table.cell(pnl, 0, 8, "Short engine")
    table.cell(pnl, 1, 8, enableShort ? "ON" : "off (tested -0.086R)")

var table sc = table.new(position.bottom_right, 2, 6, border_width = 1)
if barstate.islast and showScore
    int tot = wins + losses
    table.cell(sc, 0, 0, "FORWARD-TEST SCORE", text_color = color.white,
         bgcolor = color.new(color.blue, 25))
    table.cell(sc, 1, 0, "", bgcolor = color.new(color.blue, 25))
    table.cell(sc, 0, 1, "Closed trades")
    table.cell(sc, 1, 1, str.tostring(tot))
    table.cell(sc, 0, 2, "Win rate")
    table.cell(sc, 1, 2, tot > 0 ? str.tostring(wins * 100.0 / tot, "#.#") + "%" : "-")
    table.cell(sc, 0, 3, "  backtest was")
    table.cell(sc, 1, 3, "35.5%", text_color = color.gray)
    table.cell(sc, 0, 4, "Total R")
    table.cell(sc, 1, 4, str.tostring(sumR, "#.##") + " R",
         text_color = sumR >= 0 ? color.green : color.red)
    table.cell(sc, 0, 5, "Avg R  (target +0.29)")
    table.cell(sc, 1, 5, tot > 0 ? str.tostring(sumR / tot, "#.###") : "-",
         text_color = tot > 0 and sumR / tot >= 0.15 ? color.green : color.orange)

// =============================================================================
// ALERT CONDITIONS (simple text hooks, alongside the rich alert() messages)
// =============================================================================
alertcondition(longSignal,  "V6 Long entry",  "AURUM V6 LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, "V6 Short entry", "AURUM V6 SHORT {{ticker}} @ {{close}}")
