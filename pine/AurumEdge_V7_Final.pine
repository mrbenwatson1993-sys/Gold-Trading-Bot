//@version=5
// =============================================================================
// AURUM EDGE V7 - FINAL FORWARD-TEST EDITION - XAUUSD 30m
//
// This is the version to paste into TradingView, alert on, and forward test.
// It is V6's validated engine plus the two things V6 could not tell you:
// what to type into MT5, and when your account is too small to take the trade.
//
// -----------------------------------------------------------------------------
// VALIDATED PERFORMANCE  (out of sample, 2 Jan 2023 - 31 Aug 2026)
// Default configuration: long only, flat before the weekend, 0.25% risk, max 5.
//
//   2,238 trades      2.67 per day      E[R] +0.252
//   win rate 30.8%    profit factor 1.45
//   total +563 R      max closed drawdown 63.5 R
//   t = +6.01         bootstrap p < 0.0001
//
// Costs charged: real historical Dukascopy bid/ask spread at a 2x retail markup,
// slippage on entries and stop-outs, and overnight financing at a 4.5% carry
// (worth 0.025 R per trade, about 9% of the edge). Replace the swap assumption
// with your broker's real number once you have it.
//
//   WATCH THE WIN RATE. 31% is CORRECT. This is a trend follower: most trades
//   are small losses and a few large winners carry the whole thing. The average
//   win is 2.7x the average loss. In the out-of-sample record the longest run of
//   consecutive losers was 42, and there were 91 separate runs of six or more.
//   If you see fifteen losses in a row and conclude it is broken, you will
//   switch it off precisely when it is working normally.
//
// -----------------------------------------------------------------------------
// THE CAVEAT, UNCHANGED
//   Every trade is long, and the whole test window is a gold bull market -
//   roughly 1,800 to 3,400. In gold's least-trending slice it returned +0.118 R
//   at p = 0.066, which is not significant. This is a validated way to hold long
//   gold with disciplined risk. It is NOT validated for a sustained bear market,
//   because the data does not contain one.
//
// -----------------------------------------------------------------------------
// ACCOUNT SIZE. The broker minimum is a real constraint, not a rounding detail.
// One ounce (0.01 lots x 100 oz) is the smallest trade most brokers accept, and
// the strategy's median stop is $9.85, so the cheapest possible trade risks
// about $10 whatever your settings say.
//
//   account    risk setting   signals takeable   max floating DD   static-DD pass
//   $3,800          0.25%           47%               24%                -
//   $7,000          0.25%           91%              9.4%              85.2%
//   $10,000         0.25%           96%              6.6%              87.4%
//   $25,000         0.15%           96%                -                 88%
//
// 0.25% is the better setting on a small account, not the more aggressive one:
// a smaller risk budget is breached by MORE signals, so the constraint bites
// hardest exactly where the risk setting is lowest. Below about $3,000 nothing
// works - see the "Broker / lot sizing" group, which will say so on every alert.
//
// -----------------------------------------------------------------------------
// IF YOU ARE TRADING THIS ON A PROP ACCOUNT, screen the firm on four things:
//   1. STATIC drawdown, not trailing.        88% pass vs 33%.
//   2. NO consistency rule under 50%.        A 20% "max single day" rule fails
//                                            this bot in 99% of simulated runs,
//                                            because a trend follower's profit
//                                            concentrates into a few days by
//                                            construction. This is the rule
//                                            people forget to check.
//   3. Overnight and weekend holds allowed.  Banning overnight costs 24%.
//   4. $7,000 minimum, $10,000 comfortable.
//
// -----------------------------------------------------------------------------
// FORWARD-TEST SETUP
//   1. XAUUSD, 30-minute chart.
//   2. Set "Account size" and the two Broker / lot sizing fields to match your
//      real account. MT5: right-click the symbol > Specification.
//   3. Set commission_value below to your broker's real per-ounce cost.
//   4. Alerts: create an alert on this strategy, condition "Any alert() function
//      call", set to "Once per bar close". That is what makes the messages fire
//      with final numbers rather than mid-bar guesses.
//   5. Log every alert with its timestamp, then log when you actually got filled.
//      The gap between the two is your real execution cost, and measuring it is
//      the entire point of this exercise.
// =============================================================================

strategy(
     "Aurum Edge V7 FINAL - XAUUSD 30m",
     overlay                 = true,
     pyramiding              = 10,
     initial_capital         = 10000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 0.02,
     slippage                = 3,
     max_labels_count        = 500,
     max_lines_count         = 500,
     max_boxes_count         = 500)

// =============================================================================
// INPUTS
// =============================================================================
string G_ENG  = "1. Engines"
string G_R    = "2. Risk"
string G_BRK  = "3. Broker / lot sizing"
string G_LE   = "4. Long entries"
string G_LAD  = "5. Ladder exit"
string G_PROP = "6. Prop-firm session rules"
string G_VIS  = "7. Chart display"
string G_ALR  = "8. Alerts"

enableLong  = input.bool(true,  "Enable Long Engine (bull regime)", group = G_ENG)
enableShort = input.bool(false, "Enable Symmetric Short Engine (bear regime)", group = G_ENG,
     tooltip = "OFF by default: measured at -0.086 R over 491 trades in a genuine bear " +
               "sample (18.6% of history). 26 short variants were tested; all lost.")

riskPct    = input.float(0.25, "Risk per trade (% of equity)", 0.05, 3.0, 0.05, group = G_R,
     tooltip = "0.25% is right for a $7,000-$10,000 account. Going lower does NOT make " +
               "a small account safer - it makes more signals untakeable at the 0.01 lot " +
               "minimum, and the ones you lose are the wide-stop trades where the profit " +
               "tail lives. Use 0.15% only above $25,000.")
stopAtr    = input.float(2.0,  "Initial stop (ATR)", 0.5, 6.0, 0.1, group = G_R)
minStopUsd = input.float(8.0,  "Minimum stop ($)", 1.0, 60.0, 0.5, group = G_R,
     tooltip = "The single most important number here. Round-trip cost on gold is " +
               "roughly $0.45-$1.20; below about $5 of stop the spread eats the edge.")
maxStopUsd = input.float(200.0, "Maximum stop ($)", 20.0, 500.0, 5.0, group = G_R)
maxOpen    = input.int(5, "Max concurrent positions", 1, 10, group = G_R,
     tooltip = "Do not lower this to control risk - it is the most expensive lever on " +
               "the panel. Cutting 5 to 2 removes 64% of total profit and takes the " +
               "edge from p<0.0001 to p=0.0008; cutting to 1 takes it to p=0.039. The " +
               "five entries fire at different moments, and that spread is doing real " +
               "work: return per unit of drawdown is 7.3 at five positions and 3.0 at one.")
acctSize   = input.float(10000, "Account size ($)", 100, 10000000, 100, group = G_R,
     tooltip = "Your real balance. Drives the lot size quoted in every alert.")

// -----------------------------------------------------------------------------
// BROKER / LOT SIZING
// The 0.01 lot minimum is what stops a small account trading this at all, so the
// script needs to know it rather than quoting sizes nobody can place.
// -----------------------------------------------------------------------------
contractOz = input.float(100, "Contract size (oz per lot)", 1, 1000, 1, group = G_BRK,
     tooltip = "MT5: right-click the symbol > Specification > Contract size. Gold is " +
               "100 oz per lot at almost every broker. Confirm it empirically: open " +
               "0.01 lots and check that a $1 move in gold moves your P&L by $1.")
minLots    = input.float(0.01, "Broker minimum volume (lots)", 0.001, 10.0, 0.001, group = G_BRK,
     tooltip = "Specification > Volume minimum. Vantage and most MT5 brokers: 0.01.")
skipTooBig = input.bool(false, "Skip trades the minimum lot cannot size", group = G_BRK,
     tooltip = "OFF = take every signal, so the strategy tester stays comparable to the " +
               "validated backtest. ON = skip any trade where the broker minimum would " +
               "risk more than 1.5x your intended amount, which is what a disciplined " +
               "trader on a small account actually does. Turning this ON is the honest " +
               "test of whether YOUR account can run this.")

useDip   = input.bool(true, "E1: unconfirmed dip (N red bars in uptrend)", group = G_LE)
dipBars  = input.int(2, "   red bars required", 1, 5, group = G_LE)
useBrk   = input.bool(true, "E2: 24-bar breakout", group = G_LE)
useLegacy = input.bool(false, "E3: V3 confirmed pullback (optional)", group = G_LE,
     tooltip = "Adds ~0.06 trades/day at +0.297 R but raises drawdown 43.0 -> 48.3 R.")

r1Trig = input.float(1.5, "Rung 1 trigger (R)", 0.25, 5.0, 0.25, group = G_LAD)
r1Lock = input.float(0.0, "Rung 1 lock (R)", -1.0, 5.0, 0.1, group = G_LAD, tooltip = "0 = breakeven")
r2Trig = input.float(3.0, "Rung 2 trigger (R)", 0.5, 9.0, 0.25, group = G_LAD)
r2Lock = input.float(1.5, "Rung 2 lock (R)", -1.0, 9.0, 0.1, group = G_LAD)
r3Trig = input.float(5.0, "Rung 3 trigger (R)", 1.0, 15.0, 0.25, group = G_LAD)
r3Lock = input.float(3.2, "Rung 3 lock (R)", -1.0, 15.0, 0.1, group = G_LAD)
refTpR = input.float(3.0, "Reference target for alerts (R)", 1.0, 10.0, 0.25, group = G_LAD,
     tooltip = "The ladder has no fixed target - it rides the trend. But a manual trader " +
               "needs a number to type in, so this is the target quoted in alerts and " +
               "drawn on the chart. The walk-forward picked a 3R target in 10 of 16 folds.")
useHardTp   = input.bool(false, "Actually exit at the reference target", group = G_LAD,
     tooltip = "OFF = ladder runs free (validated). ON = hard 3R exit, simpler to trade " +
               "manually but gives up the long tail that carries the edge.")
maxHoldBars = input.int(96, "Time stop (bars)", 8, 500, group = G_LAD,
     tooltip = "96 x 30m = 48 hours. Cutting to 48 (24h) costs 18% of expectancy per " +
               "trade but gains 20% more trades, so total profit is unchanged.")
atrLen      = input.int(14, "ATR length", 2, 100, group = G_LAD)

// -----------------------------------------------------------------------------
// PROP-FIRM SESSION RULES
// Measured cost of each, out of sample, after real spreads AND financing:
//
//   as shipped, 48h hold        +0.254 R/trade   +565 R total
//   flat before Friday          +0.252 R/trade   +563 R total   <- default, ~free
//   24h cap + flat Friday       +0.208 R/trade   +560 R total   <- also free in total
//   no overnight at all         +0.142 R/trade   +428 R total   <- costs 24% of profit
//
// Shortening the hold lowers expectancy per trade but raises the trade count by
// about the same proportion. Banning overnight holds outright is the only one
// that really hurts.
//
// Flattening before the weekend is ON by default. It costs 0.4% of total profit
// and removes the single event that can end an account in one print: 5.6% of
// weekends gapped more than a full stop distance, the worst was 4x, and the bot
// held all five positions through 40 of the 81 weekends it was exposed to.
// -----------------------------------------------------------------------------
flatFriday = input.bool(true, "Flatten everything before the weekend", group = G_PROP)
friFlatH   = input.int(20, "   Friday flatten hour (UTC)", 12, 23, group = G_PROP)
flatDaily  = input.bool(false, "Flatten before the daily rollover (no overnight)", group = G_PROP,
     tooltip = "True intraday operation. Costs 24% of total profit and removes financing " +
               "cost. Turn on only if your firm forbids overnight positions.")
dayFlatH   = input.int(20, "   Daily flatten hour (UTC)", 0, 23, group = G_PROP)

showLines  = input.bool(true, "Draw entry / stop / target lines", group = G_VIS)
showRungs  = input.bool(true, "Draw ladder rung levels", group = G_VIS)
showLabels = input.bool(true, "Label entries with prices", group = G_VIS)
showPanel  = input.bool(true, "Show live panel", group = G_VIS)
showScore  = input.bool(true, "Show running scoreboard", group = G_VIS)
tintBg     = input.bool(true, "Tint background by regime", group = G_VIS)
keepClosed = input.bool(true, "Keep closed trades drawn on the chart", group = G_VIS)

alertEntry = input.bool(true, "Alert on entry", group = G_ALR)
alertRung  = input.bool(true, "Alert when a rung arms (move your stop)", group = G_ALR)
alertExit  = input.bool(true, "Alert on exit", group = G_ALR)

// =============================================================================
// REGIME + SIGNALS
// Only completed daily bars are used, so the regime gate cannot repaint.
// =============================================================================
dE20  = request.security(syminfo.tickerid, "D", ta.ema(close, 20)[1],  lookahead = barmerge.lookahead_on)
dE50  = request.security(syminfo.tickerid, "D", ta.ema(close, 50)[1],  lookahead = barmerge.lookahead_on)
dE200 = request.security(syminfo.tickerid, "D", ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on)
bool macroBull = dE20 > dE50 and dE50 > dE200
bool macroBear = dE20 < dE50 and dE50 < dE200

ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr    = ta.atr(atrLen)

plot(ema20,  "EMA20",  color = color.new(color.aqua, 30),   linewidth = 1)
plot(ema50,  "EMA50",  color = color.new(color.orange, 30), linewidth = 1)
plot(ema200, "EMA200", color = color.new(color.purple, 20), linewidth = 2)

bool stackUp = ema20 > ema50 and ema50 > ema200
bool stackDn = ema20 < ema50 and ema50 < ema200
float hh24 = ta.highest(high, 24)[1]
float ll24 = ta.lowest(low, 24)[1]

int redRun = 0
int grnRun = 0
for i = 0 to dipBars - 1
    redRun += close[i] < open[i] ? 1 : 0
    grnRun += close[i] > open[i] ? 1 : 0

bool sigDip    = useDip    and stackUp and redRun == dipBars
bool sigBrk    = useBrk    and close > hh24 and close > open
bool sigLegacy = useLegacy and stackUp and ema20 > ema20[3] and low <= ema20 and close > ema20 and close > open
bool longSignal = enableLong and macroBull and (sigDip or sigBrk or sigLegacy)

bool sigDipS = useDip and stackDn and grnRun == dipBars
bool sigBrkS = useBrk and close < ll24 and close < open
bool shortSignal = enableShort and macroBear and (sigDipS or sigBrkS)

// =============================================================================
// SIZING - against the broker's real minimum, not an idealised fractional lot
// =============================================================================
// Every divisor below is guaranteed positive by its input minval - stopDist is
// floored at minStopUsd (min 1.0), contractOz at 1, minLots at 0.001, acctSize
// at 100 - so none of this needs a "? ... : na" guard. That matters: a ternary
// with a bare na on one branch is the classic way to make Pine fail to infer a
// type, and it fails at compile time with a message that points somewhere else.
float stopDist = math.min(math.max(atr * stopAtr, minStopUsd), maxStopUsd)
float qty      = (strategy.equity * riskPct / 100.0) / stopDist

float budgetUsd  = acctSize * riskPct / 100.0
float wantOz     = budgetUsd / stopDist
float wantLots   = wantOz / contractOz
float minOz      = contractOz * minLots
float minRiskUsd = minOz * stopDist
float minRiskPct = minRiskUsd / acctSize * 100.0

// The size you would actually type into MT5: rounded to the broker's volume
// step, never below its minimum.
float placeLots = math.max(math.floor(wantLots / minLots + 0.5) * minLots, minLots)
float placeOz   = placeLots * contractOz
float placeRisk = placeOz * stopDist
float placePct  = placeRisk / acctSize * 100.0

// True when the smallest trade the broker accepts already risks more than
// intended. 1.5x is the tolerance used in the account-size study.
bool overSized = minOz > wantOz * 1.5

int openLongs = 0
int openShorts = 0
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        if strategy.opentrades.size(i) > 0
            openLongs += 1
        else
            openShorts += 1

// =============================================================================
// TRADE STATE + CHART DRAWING
// Parallel arrays keep each open trade's own levels and its own drawings, so a
// position opened three bars ago keeps its own stop and its own lines when a
// second one opens beside it.
// =============================================================================
var array<string> tIds   = array.new_string()
var array<float>  tEntry = array.new_float()
var array<float>  tRisk  = array.new_float()
var array<int>    tDir   = array.new_int()
var array<int>    tBar   = array.new_int()
var array<int>    tRung  = array.new_int()
var array<line>   lnE    = array.new_line()
var array<line>   lnS    = array.new_line()
var array<line>   lnT    = array.new_line()
var array<line>   lnR1   = array.new_line()
var array<line>   lnR2   = array.new_line()
var array<line>   lnR3   = array.new_line()

var int seq = 0
var int wins = 0
var int losses = 0
var float sumR = 0.0
var int skipped = 0

_mkline(float y, color col, string st, int w, bool on) =>
    line out = na
    if on
        out := line.new(bar_index, y, bar_index, y, xloc = xloc.bar_index,
             color = col, style = st, width = w)
    out

_open(int dir, string tag) =>
    seq += 1
    string id = (dir > 0 ? "L" : "S") + str.tostring(seq)
    float ep = close
    float sl = ep - stopDist * dir
    float tp = ep + stopDist * refTpR * dir
    if dir > 0
        strategy.entry(id, strategy.long, qty = qty)
    else
        strategy.entry(id, strategy.short, qty = qty)

    array.push(tIds, id)
    array.push(tEntry, ep)
    array.push(tRisk, stopDist)
    array.push(tDir, dir)
    array.push(tBar, bar_index)
    array.push(tRung, 0)
    bool drawRungs = showLines and showRungs
    array.push(lnE,  _mkline(ep, color.new(color.yellow, 0), line.style_solid, 2, showLines))
    array.push(lnS,  _mkline(sl, color.new(color.red, 0),    line.style_solid, 2, showLines))
    array.push(lnT,  _mkline(tp, color.new(color.green, 0),  line.style_solid, 2, showLines))
    array.push(lnR1, _mkline(ep + r1Trig * stopDist * dir, color.new(color.gray, 40), line.style_dotted, 1, drawRungs))
    array.push(lnR2, _mkline(ep + r2Trig * stopDist * dir, color.new(color.gray, 55), line.style_dotted, 1, drawRungs))
    array.push(lnR3, _mkline(ep + r3Trig * stopDist * dir, color.new(color.gray, 70), line.style_dotted, 1, drawRungs))

    if showLabels
        label.new(bar_index, dir > 0 ? low : high,
             (dir > 0 ? "▲ " : "▼ ") + tag + "\n" + str.tostring(ep, format.mintick),
             style = dir > 0 ? label.style_label_up : label.style_label_down,
             color = dir > 0 ? color.new(color.green, 15) : color.new(color.red, 15),
             textcolor = color.white, size = size.tiny)

    if alertEntry
        // The size block is built separately because what a small account needs
        // to be told is not a number, it is "do not take this one".
        string sizeBlock = ""
        if overSized
            sizeBlock := "\n! SIZE   " + str.tostring(minLots, "#.###") + " lots is your BROKER MINIMUM"
            sizeBlock := sizeBlock + "\n         correct size is " + str.tostring(wantLots, "#.####") + " lots"
            sizeBlock := sizeBlock + "\n         minimum risks $" + str.tostring(minRiskUsd, "#.##") +
                 " = " + str.tostring(minRiskPct, "#.##") + "% of " + str.tostring(acctSize, "#")
            sizeBlock := sizeBlock + "\n         ACCOUNT TOO SMALL - SKIP THIS TRADE"
        else
            sizeBlock := "\nSIZE   " + str.tostring(placeLots, "#.###") + " lots  (" +
                 str.tostring(placeOz, "#.##") + " oz)"
            sizeBlock := sizeBlock + "\nRISK   $" + str.tostring(placeRisk, "#.##") +
                 "  = " + str.tostring(placePct, "#.##") + "% of " + str.tostring(acctSize, "#")
        alert(
             (dir > 0 ? "🟢 LONG " : "🔴 SHORT ") + syminfo.ticker + "  [" + tag + "]" +
             "\nENTRY  " + str.tostring(ep, format.mintick) +
             "\nSTOP   " + str.tostring(sl, format.mintick) +
             "  (" + str.tostring(stopDist, "#.##") + " away)" +
             "\nTARGET " + str.tostring(tp, format.mintick) +
             "  (" + str.tostring(refTpR, "#.#") + "R)" +
             sizeBlock +
             "\nBAR    " + str.format_time(time_close, "yyyy-MM-dd HH:mm", "UTC") + " UTC",
             alert.freq_once_per_bar_close)
    id

// -----------------------------------------------------------------------------
// SESSION GUARD. Both rules are evaluated in UTC on the completed bar, so they
// fire at the same moment in backtest and live regardless of the chart timezone.
// -----------------------------------------------------------------------------
bool weekendCut = flatFriday and dayofweek(time, "UTC") == dayofweek.friday and hour(time, "UTC") >= friFlatH
bool rolloverCut = flatDaily and hour(time, "UTC") >= dayFlatH
bool forceFlat = weekendCut or rolloverCut

if forceFlat and strategy.opentrades > 0
    strategy.close_all(comment = weekendCut ? "weekend flat" : "session flat")

bool sizeBlocked = skipTooBig and overSized
bool canTrade = not forceFlat and not sizeBlocked and not na(qty) and qty > 0

if (longSignal or shortSignal) and sizeBlocked
    skipped += 1

if longSignal and canTrade and openLongs < maxOpen
    _open(1, sigDip ? "DIP" : sigBrk ? "BREAKOUT" : "PULLBACK")

if shortSignal and canTrade and openShorts < maxOpen
    _open(-1, sigDipS ? "RALLY" : "BREAKDOWN")

// =============================================================================
// MANAGE OPEN TRADES: ladder, drawings, exits
// The ratchet reads the COMPLETED bar's close, never an intrabar extreme. That
// is why calc_on_every_tick is false - trailing from a running high banks levels
// the trade never actually held, which in testing produced a +0.089 R phantom
// edge on coin-flip entries where the true answer is mathematically zero.
// =============================================================================
int nTrades = array.size(tIds)
if nTrades > 0
    for k = nTrades - 1 to 0
        string id = array.get(tIds, k)
        float ep  = array.get(tEntry, k)
        float rp  = array.get(tRisk, k)
        int   dir = array.get(tDir, k)
        int   eb  = array.get(tBar, k)
        int   rung = array.get(tRung, k)

        bool stillOpen = false
        if strategy.opentrades > 0
            for i = 0 to strategy.opentrades - 1
                if strategy.opentrades.entry_id(i) == id
                    stillOpen := true

        if stillOpen and rp > 0
            float excR = (close - ep) * dir / rp
            float sl = ep - rp * dir
            int newRung = 0
            if excR >= r3Trig
                sl := ep + r3Lock * rp * dir
                newRung := 3
            else if excR >= r2Trig
                sl := ep + r2Lock * rp * dir
                newRung := 2
            else if excR >= r1Trig
                sl := ep + r1Lock * rp * dir
                newRung := 1

            if newRung > rung
                array.set(tRung, k, newRung)
                if alertRung
                    alert("🔧 MOVE STOP  " + syminfo.ticker + "  [" + id + "]" +
                         "\nReached +" + str.tostring(newRung == 3 ? r3Trig : newRung == 2 ? r2Trig : r1Trig, "#.#") + "R" +
                         "\nNEW STOP  " + str.tostring(sl, format.mintick) +
                         (math.abs(sl - ep) < syminfo.mintick ? "  (breakeven)" :
                          "  (locks +" + str.tostring((sl - ep) * dir / rp, "#.##") + "R)") +
                         "\nEntry was " + str.tostring(ep, format.mintick),
                         alert.freq_once_per_bar_close)

            float tp = ep + rp * refTpR * dir
            if useHardTp
                strategy.exit("x" + id, from_entry = id, stop = sl, limit = tp)
            else
                strategy.exit("x" + id, from_entry = id, stop = sl)

            if not na(array.get(lnE, k))
                line.set_x2(array.get(lnE, k), bar_index)
                line.set_xy2(array.get(lnS, k), bar_index, sl)
                line.set_x2(array.get(lnT, k), bar_index)
            if not na(array.get(lnR1, k))
                line.set_x2(array.get(lnR1, k), bar_index)
                line.set_x2(array.get(lnR2, k), bar_index)
                line.set_x2(array.get(lnR3, k), bar_index)

            if bar_index - eb >= maxHoldBars
                strategy.close(id, comment = "time stop")

        else if not stillOpen
            // Trade has closed: score it, alert, and stop extending its drawings.
            float exitPx = close
            float rMult = (exitPx - ep) * dir / rp
            sumR += rMult
            if rMult > 0
                wins += 1
            else
                losses += 1
            if alertExit
                alert((rMult > 0 ? "✅ CLOSED +" : "❌ CLOSED ") + str.tostring(rMult, "#.##") + "R  " +
                     syminfo.ticker + "  [" + id + "]" +
                     "\nEntry " + str.tostring(ep, format.mintick) +
                     "  ->  Exit ~" + str.tostring(exitPx, format.mintick) +
                     "\nHeld " + str.tostring(bar_index - eb) + " bars",
                     alert.freq_once_per_bar_close)
            if not keepClosed
                if not na(array.get(lnE, k))
                    line.delete(array.get(lnE, k))
                    line.delete(array.get(lnS, k))
                    line.delete(array.get(lnT, k))
                if not na(array.get(lnR1, k))
                    line.delete(array.get(lnR1, k))
                    line.delete(array.get(lnR2, k))
                    line.delete(array.get(lnR3, k))
            array.remove(tIds, k)
            array.remove(tEntry, k)
            array.remove(tRisk, k)
            array.remove(tDir, k)
            array.remove(tBar, k)
            array.remove(tRung, k)
            array.remove(lnE, k)
            array.remove(lnS, k)
            array.remove(lnT, k)
            array.remove(lnR1, k)
            array.remove(lnR2, k)
            array.remove(lnR3, k)

// =============================================================================
// DISPLAY
// =============================================================================
bgcolor(tintBg and macroBull ? color.new(color.green, 95) :
        tintBg and macroBear ? color.new(color.red, 95) : na, title = "Regime")

plotshape(longSignal,  "Long signal",  shape.triangleup,   location.belowbar,
     color.new(color.green, 0), size = size.tiny)
plotshape(shortSignal, "Short signal", shape.triangledown, location.abovebar,
     color.new(color.red, 0),   size = size.tiny)

var table pnl = table.new(position.top_right, 2, 10, border_width = 1)
if barstate.islast and showPanel
    table.cell(pnl, 0, 0, "AURUM V7 FINAL", text_color = color.white,
         bgcolor = color.new(color.teal, 20))
    table.cell(pnl, 1, 0, "", bgcolor = color.new(color.teal, 20))
    table.cell(pnl, 0, 1, "Daily regime")
    table.cell(pnl, 1, 1, macroBull ? "BULL — armed" : macroBear ? "BEAR" : "neutral — flat",
         text_color = macroBull ? color.green : macroBear ? color.red : color.gray)
    table.cell(pnl, 0, 2, "Open trades")
    table.cell(pnl, 1, 2, str.tostring(strategy.opentrades) + " / " + str.tostring(maxOpen))
    table.cell(pnl, 0, 3, "Next stop ($)")
    table.cell(pnl, 1, 3, str.tostring(stopDist, "#.##"))
    table.cell(pnl, 0, 4, "Next size (lots)")
    table.cell(pnl, 1, 4, str.tostring(placeLots, "#.###"),
         text_color = overSized ? color.red : color.green)
    table.cell(pnl, 0, 5, "Next risk")
    table.cell(pnl, 1, 5, "$" + str.tostring(placeRisk, "#.##") + "  (" +
         str.tostring(placePct, "#.##") + "%)",
         text_color = overSized ? color.red : color.gray)
    table.cell(pnl, 0, 6, "Account big enough?")
    table.cell(pnl, 1, 6, overSized ? "NO — min lot is " + str.tostring(minRiskPct, "#.#") + "%" : "yes",
         text_color = overSized ? color.red : color.green)
    table.cell(pnl, 0, 7, "Cost as % of risk")
    table.cell(pnl, 1, 7, str.tostring(0.45 / stopDist * 100, "#.#") + "%")
    table.cell(pnl, 0, 8, "Open R (unrealised)")
    float openR = 0.0
    if array.size(tIds) > 0
        for k = 0 to array.size(tIds) - 1
            openR += (close - array.get(tEntry, k)) * array.get(tDir, k) / array.get(tRisk, k)
    table.cell(pnl, 1, 8, str.tostring(openR, "#.##") + " R",
         text_color = openR >= 0 ? color.green : color.red)
    table.cell(pnl, 0, 9, "Signals skipped (too big)")
    table.cell(pnl, 1, 9, str.tostring(skipped),
         text_color = skipped > 0 ? color.orange : color.gray)

var table sc = table.new(position.bottom_right, 2, 6, border_width = 1)
if barstate.islast and showScore
    int tot = wins + losses
    table.cell(sc, 0, 0, "FORWARD-TEST SCORE", text_color = color.white,
         bgcolor = color.new(color.blue, 25))
    table.cell(sc, 1, 0, "", bgcolor = color.new(color.blue, 25))
    table.cell(sc, 0, 1, "Closed trades")
    table.cell(sc, 1, 1, str.tostring(tot))
    table.cell(sc, 0, 2, "Win rate")
    table.cell(sc, 1, 2, tot > 0 ? str.tostring(wins * 100.0 / tot, "#.#") + "%" : "-")
    table.cell(sc, 0, 3, "  backtest was")
    table.cell(sc, 1, 3, "30.8%", text_color = color.gray)
    table.cell(sc, 0, 4, "Total R")
    table.cell(sc, 1, 4, str.tostring(sumR, "#.##") + " R",
         text_color = sumR >= 0 ? color.green : color.red)
    table.cell(sc, 0, 5, "Avg R  (target +0.25)")
    table.cell(sc, 1, 5, tot > 0 ? str.tostring(sumR / tot, "#.###") : "-",
         text_color = tot > 0 and sumR / tot >= 0.12 ? color.green : color.orange)

// =============================================================================
// ALERT CONDITIONS (simple text hooks, alongside the rich alert() messages)
// =============================================================================
alertcondition(longSignal,  "V7 Long entry",  "AURUM V7 LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, "V7 Short entry", "AURUM V7 SHORT {{ticker}} @ {{close}}")
