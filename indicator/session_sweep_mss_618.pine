//@version=6
// =============================================================================
//  SESSION SWEEP -> MSS -> 0.618        alert tool for manual execution
//  Put this on a 5 MINUTE chart.
//  Alert: condition = this indicator, trigger = "Any alert() function call",
//         frequency = "Once Per Bar".
// =============================================================================
indicator("Session Sweep MSS 618", "SWEEP MSS 618", overlay = true, max_boxes_count = 200, max_labels_count = 200)

// ----------------------------- INPUTS ----------------------------------------
gS = "Sessions"
tzIn   = input.string("Europe/London", "Timezone", options = ["UTC", "Europe/London", "America/New_York", "America/Chicago", "Europe/Berlin", "Asia/Tokyo", "Asia/Dubai", "Australia/Sydney"], group = gS)
asiaIn = input.session("0000-0800", "Asia session", group = gS)
lonIn  = input.session("0800-1300", "London session", group = gS)
nyIn   = input.session("1300-2100", "New York session", group = gS)
useA   = input.bool(true, "Trade Asia", group = gS)
useL   = input.bool(true, "Trade London", group = gS)
useN   = input.bool(true, "Trade New York", group = gS)
boxOn  = input.bool(true, "Draw session boxes", group = gS)
maxAge = input.float(12, "Previous range stale after (hours, 0 = never)", minval = 0, maxval = 200, group = gS)

gT = "Structure"
fracLen  = input.int(2, "Fractal strength", minval = 1, maxval = 10, group = gT)
needBody = input.bool(true, "Require a body close through the fractal", group = gT)
maxSet   = input.int(1, "Max setups per session", minval = 1, maxval = 5, group = gT)

gE = "Entry, stop, target"
fibIn    = input.float(0.618, "Fib entry level", minval = 0.1, maxval = 0.99, step = 0.001, group = gE)
rrIn     = input.float(2.0, "Target R multiple", minval = 0.5, maxval = 10, step = 0.1, group = gE)
bufIn    = input.int(0, "Stop buffer in ticks", minval = 0, maxval = 1000, group = gE)
extendOn = input.bool(true, "Redraw the fib while the leg runs", group = gE)

gR = "Position size"
sizeOn  = input.bool(true, "Show lot size in the alert", group = gR)
acctIn  = input.float(10000, "Account balance in quote currency", minval = 1, step = 100, group = gR)
riskIn  = input.float(1.0, "Risk per trade percent", minval = 0.05, maxval = 25, step = 0.05, group = gR)
lotUnit = input.float(100000, "Units per standard lot", minval = 1, group = gR)
lotStp  = input.float(0.01, "Lot step", minval = 0.001, step = 0.01, group = gR)

gA = "Alerts"
alSweep = input.bool(false, "Alert on the sweep", group = gA)
alArm   = input.bool(true, "Alert when a setup arms", group = gA)
alMove  = input.bool(true, "Alert when the level moves", group = gA)
alTap   = input.bool(true, "Alert when price taps the entry", group = gA)
alDone  = input.bool(true, "Alert on target or stop", group = gA)
movePip = input.float(1.0, "Re-alert only if the level moved more than this many pips", minval = 0, step = 0.1, group = gA)

gD = "Display"
showLv = input.bool(true, "Entry stop target lines", group = gD)
showTb = input.bool(true, "Status panel", group = gD)

// ----------------------------- CONSTANTS -------------------------------------
tickSz = syminfo.mintick
ptVal  = syminfo.pointvalue == 0 ? 1.0 : syminfo.pointvalue
pipSz  = syminfo.type == "forex" ? tickSz * 10 : tickSz

// ----------------------------- SESSIONS --------------------------------------
inA  = not na(time(timeframe.period, asiaIn, tzIn))
inL  = not na(time(timeframe.period, lonIn, tzIn))
inN  = not na(time(timeframe.period, nyIn, tzIn))
sNow = inN ? 3 : inL ? 2 : inA ? 1 : 0
sOk  = (sNow == 1 and useA) or (sNow == 2 and useL) or (sNow == 3 and useN)

var int   curS  = 0
var float sHi   = na
var float sLo   = na
var float pHi   = na
var float pLo   = na
var int   pS    = 0
var int   pEnd  = na
var box   sBox  = na
var int   nSet  = 0

var int   dir    = 0
var bool  swept  = false
var int   shift  = 0
var float legH   = na
var float legL   = na
var float ent    = na
var float stp    = na
var float tgt    = na
var bool  armed  = false
var bool  livePos = false
var float lastAl = na
var int   armAt  = na

chg = sNow != curS

if chg
    if curS != 0 and not na(sHi)
        pHi := sHi
        pLo := sLo
        pS := curS
        pEnd := time
    curS := sNow
    nSet := 0
    sHi := sNow != 0 ? high : na
    sLo := sNow != 0 ? low : na
    dir := 0
    swept := false
    shift := 0
    legH := na
    legL := na
    ent := na
    stp := na
    tgt := na
    armed := false
    livePos := false
    lastAl := na
    armAt := na

if not chg and sNow != 0
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)

if chg and sNow != 0 and boxOn
    bc = sNow == 1 ? color.orange : sNow == 2 ? color.blue : color.purple
    sBox := box.new(bar_index, high, bar_index + 1, low, border_color = color.new(bc, 50), bgcolor = color.new(bc, 92))

if sNow != 0 and boxOn and not na(sBox)
    box.set_top(sBox, sHi)
    box.set_bottom(sBox, sLo)
    box.set_right(sBox, bar_index + 1)

// ----------------------------- FRACTALS --------------------------------------
fh  = ta.pivothigh(high, fracLen, fracLen)
fl  = ta.pivotlow(low, fracLen, fracLen)
loN = ta.lowest(low, fracLen + 1)
hiN = ta.highest(high, fracLen + 1)

var float lastH = na
var float lastL = na
var float minSince = na
var float maxSince = na

if not na(fh)
    lastH := fh
    minSince := loN
else
    minSince := math.min(nz(minSince, low), low)

if not na(fl)
    lastL := fl
    maxSince := hiN
else
    maxSince := math.max(nz(maxSince, high), high)

// ----------------------------- STEP 1  SWEEP ---------------------------------
fresh = maxAge <= 0 or (not na(pEnd) and (time - pEnd) <= maxAge * 3600000)
sweepNow = false

if sNow != 0 and sOk and fresh and not swept and not na(pHi) and not na(pLo)
    hiHit = high > pHi
    loHit = low < pLo
    if hiHit or loHit
        dir := hiHit and loHit ? (close < open ? -1 : 1) : (hiHit ? -1 : 1)
        swept := true
        sweepNow := true

// ----------------------------- STEP 2  SHIFT ---------------------------------
brkDn = not na(lastL) and (needBody ? close < lastL : low < lastL)
brkUp = not na(lastH) and (needBody ? close > lastH : high > lastH)
mssNow = false

if swept and shift == 0 and sNow != 0 and not livePos and nSet < maxSet and barstate.isconfirmed
    if dir == -1 and brkDn
        shift := -1
        legH := nz(lastH, high)
        legL := nz(minSince, low)
        mssNow := true
    if dir == 1 and brkUp
        shift := 1
        legL := nz(lastL, low)
        legH := nz(maxSince, high)
        mssNow := true

// ----------------------------- STEP 3  FIB -----------------------------------
moved = false

if shift != 0 and not livePos
    if extendOn and shift == -1
        legL := math.min(legL, low)
    if extendOn and shift == 1
        legH := math.max(legH, high)
    rngv = legH - legL
    if rngv > 0
        newEnt = shift == -1 ? legL + fibIn * rngv : legH - fibIn * rngv
        newStp = shift == -1 ? legH + bufIn * tickSz : legL - bufIn * tickSz
        rsk = math.abs(newStp - newEnt)
        moved := armed and math.abs(newEnt - nz(lastAl, newEnt)) > movePip * pipSz
        ent := newEnt
        stp := newStp
        tgt := shift == -1 ? newEnt - rrIn * rsk : newEnt + rrIn * rsk
        if not armed
            armAt := bar_index
        armed := true

// invalidation: price trades back through the origin of the leg
killed = false
if armed and not livePos and shift == -1 and high > legH + bufIn * tickSz
    killed := true
if armed and not livePos and shift == 1 and low < legL - bufIn * tickSz
    killed := true

// the tap
tapNow = false
if armed and not livePos and not killed and not na(ent) and shift == -1 and high >= ent
    livePos := true
    tapNow := true
    nSet := nSet + 1
if armed and not livePos and not killed and not na(ent) and shift == 1 and low <= ent
    livePos := true
    tapNow := true
    nSet := nSet + 1

// the result
winNow = false
lossNow = false
if livePos and not na(tgt) and shift == -1 and low <= tgt
    winNow := true
if livePos and not na(stp) and shift == -1 and high >= stp
    lossNow := true
if livePos and not na(tgt) and shift == 1 and high >= tgt
    winNow := true
if livePos and not na(stp) and shift == 1 and low <= stp
    lossNow := true

// ----------------------------- SIZE ------------------------------------------
sDist  = math.abs(nz(stp) - nz(ent))
rCash  = acctIn * riskIn / 100.0
rUnits = sDist > 0 ? rCash / (sDist * ptVal) : 0.0
lots   = math.floor(rUnits / lotUnit / lotStp) * lotStp

// ----------------------------- MESSAGE ---------------------------------------
sideTxt  = shift == -1 ? "SHORT" : "LONG"
sweepTxt = dir == -1 ? "HIGH" : "LOW"
nowName  = curS == 1 ? "Asia" : curS == 2 ? "London" : curS == 3 ? "New York" : "-"
prevName = pS == 1 ? "Asia" : pS == 2 ? "London" : pS == 3 ? "New York" : "-"
lotTxt   = lots <= 0 ? "BELOW MIN LOT" : str.tostring(lots, "#.##") + " lots"

msg = sideTxt + " " + syminfo.ticker + " " + timeframe.period + "\n"
msg := msg + nowName + " swept " + prevName + " " + sweepTxt + "\n"
msg := msg + "Entry  " + str.tostring(ent, format.mintick) + "\n"
msg := msg + "Stop   " + str.tostring(stp, format.mintick) + "\n"
msg := msg + "Target " + str.tostring(tgt, format.mintick) + "\n"
msg := msg + "Risk   " + str.tostring(sDist / pipSz, "#.#") + " pips"

if sizeOn
    msg := msg + "\nSize   " + lotTxt

// ----------------------------- ALERTS ----------------------------------------
if alSweep and sweepNow
    alert("SWEEP  " + syminfo.ticker + "  " + nowName + " took " + prevName + " " + sweepTxt, alert.freq_once_per_bar)

if alArm and armed and armAt == bar_index and not na(ent)
    alert("SETUP ARMED\n" + msg, alert.freq_once_per_bar)
    lastAl := ent

if alMove and moved and not na(ent)
    alert("LEVEL MOVED\n" + msg, alert.freq_once_per_bar)
    lastAl := ent

if alTap and tapNow
    alert("ENTRY TAPPED\n" + msg, alert.freq_once_per_bar)

if alDone and winNow
    alert("TARGET HIT  " + syminfo.ticker + "  plus " + str.tostring(rrIn, "#.#") + "R", alert.freq_once_per_bar)

if alDone and lossNow
    alert("STOP HIT  " + syminfo.ticker + "  minus 1R", alert.freq_once_per_bar)

// ----------------------------- DRAWING ---------------------------------------
if mssNow and shift == -1
    label.new(bar_index, high, "MSS", style = label.style_label_down, color = color.new(color.red, 20), textcolor = color.white, size = size.tiny)

if mssNow and shift == 1
    label.new(bar_index, low, "MSS", style = label.style_label_up, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny)

showE = showLv and armed and not na(ent)
plot(showE ? ent : na, "Entry", color.new(color.orange, 0), 2, plot.style_linebr)
plot(showE ? stp : na, "Stop", color.new(color.red, 0), 1, plot.style_linebr)
plot(showE ? tgt : na, "Target", color.new(color.green, 0), 1, plot.style_linebr)
plot(sNow != 0 and not na(pHi) ? pHi : na, "Prev high", color.new(color.gray, 30), 1, plot.style_linebr)
plot(sNow != 0 and not na(pLo) ? pLo : na, "Prev low", color.new(color.gray, 30), 1, plot.style_linebr)

// ----------------------------- PANEL -----------------------------------------
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)

if showTb and barstate.islast
    stTxt = "waiting for sweep"
    if sNow == 0
        stTxt := "no session"
    if sNow != 0 and not sOk
        stTxt := "session switched off"
    if sNow != 0 and sOk and not fresh
        stTxt := "prev range stale"
    if swept and shift == 0
        stTxt := "waiting for the shift"
    if armed and not livePos
        stTxt := "ARMED at the 0.618"
    if livePos
        stTxt := "in trade"
    table.cell(tb, 0, 0, "SWEEP MSS 618", text_color = color.white, text_size = size.tiny)
    table.cell(tb, 1, 0, nowName, text_color = color.white, text_size = size.tiny)
    table.cell(tb, 0, 1, "state", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 1, stTxt, text_color = color.aqua, text_size = size.tiny)
    table.cell(tb, 0, 2, "prev range", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 2, na(pHi) ? "-" : str.tostring(pLo, format.mintick) + " / " + str.tostring(pHi, format.mintick), text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 0, 3, "sweep", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 3, swept ? sweepTxt + " taken" : "none", text_color = color.yellow, text_size = size.tiny)
    table.cell(tb, 0, 4, "entry", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 4, showE ? str.tostring(ent, format.mintick) : "-", text_color = color.orange, text_size = size.tiny)
    table.cell(tb, 0, 5, "stop / target", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 5, showE ? str.tostring(stp, format.mintick) + " / " + str.tostring(tgt, format.mintick) : "-", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 0, 6, "size", text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 6, showE ? lotTxt : "-", text_color = color.white, text_size = size.tiny)

// ----------------------------- END OF BAR RESET ------------------------------
// Runs last so every alert, plot and panel cell above read intact state.
if killed or winNow or lossNow
    dir := 0
    swept := false
    shift := 0
    legH := na
    legL := na
    ent := na
    stp := na
    tgt := na
    armed := false
    livePos := false
    lastAl := na
    armAt := na
